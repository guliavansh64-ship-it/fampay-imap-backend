# =================================================================
# FatafatPay FamPay IMAP Backend — Environment Configuration
# Copy this file to .env for local development or set in Vercel Dashboard
# =================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# Shared Secret Key between PHP Website and this Node.js Backend
# Generate a strong 32+ character random string (e.g. openssl rand -hex 24)
FAMPAY_BACKEND_KEY=your_secure_random_api_key_here

# IMAP Host Configuration (Default: Gmail SSL)
GMAIL_HOST=imap.gmail.com
GMAIL_PORT=993
GMAIL_SECURE=true

# Optional: Default fallback mailbox credentials (if not passed in request body)
# Usually left blank because each merchant provides their own credentials
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Timeout Settings (in milliseconds)
# Recommended: 12000 (12 seconds) for serverless compatibility
IMAP_TIMEOUT_MS=12000

# Search & Fetch Limits
SEARCH_DAYS=2
FETCH_LIMIT=30
